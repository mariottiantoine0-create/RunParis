// Perfect Run sur Cloudflare (Workers, fichiers statiques) : publie le dossier site/ tel quel, sans étape de construction.
// Les en-têtes (cache, sécurité) sont dans site/_headers.
// Production (main) : perfectrun.fr · staging : aperçu de la branche staging (onglet Deployments du Worker).
{
  "name": "perfectrun",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": true,
  "previews": {},
  "assets": {
    "directory": "./site"
  }
}
