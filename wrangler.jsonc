// Perfect Run sur Cloudflare (Workers) : publie le dossier site/ tel quel, sans étape de construction.
// Les en-têtes (cache, sécurité) sont dans site/_headers.
// worker.js ne tourne que pour /api/* et /r/* (liens courts) (« Signaler un problème » → email) ; tout le reste est servi directement depuis site/.
// Production (main) : perfectrun.fr · staging : aperçu de la branche staging (onglet Deployments du Worker).
// Secret à régler dans Cloudflare (Settings → Variables and Secrets) : SIGNAL_TO = adresse qui reçoit les signalements.
{
  "name": "perfectrun",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": true,
  // aperçus des branches (Prochaine, staging) : ils n’héritent pas des liaisons de la production ; même espace KV pour que les liens courts y marchent aussi
  "previews": {
    "kv_namespaces": [
      { "binding": "LIENS", "id": "726cdb801b6c4f2a9fd29b4ebd71dab3" }
    ]
  },
  "keep_vars": true,
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/r/*"]
  },
  // limite d'envois du formulaire de signalement : 3 par minute et par adresse IP (D-111)
  "ratelimits": [
    { "name": "SIGNAL_LIMIT", "namespace_id": "1001", "simple": { "limit": 3, "period": 60 } },
    { "name": "LIEN_LIMIT", "namespace_id": "1002", "simple": { "limit": 20, "period": 60 } }
  ],
  // liens courts perfectrun.fr/r/… (retour du 2/11) : parcours partagés, gardés dans Workers KV « perfectrun-liens »
  "kv_namespaces": [
    { "binding": "LIENS", "id": "726cdb801b6c4f2a9fd29b4ebd71dab3" }
  ],
  "send_email": [
    { "name": "MAIL" }
  ]
}
