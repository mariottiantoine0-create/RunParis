# En-têtes HTTP pour Cloudflare Pages (équivalent des [[headers]] de netlify.toml)
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(self), camera=(), microphone=()
  # sécurité (D-111) : HTTPS imposé pendant un an ; liste des seules adresses que les pages ont le droit d'appeler ; pas d'affichage dans un cadre d'un autre site
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://gc.zgo.at; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://runparis.goatcounter.com; connect-src 'self' https://data.geopf.fr https://runparis.goatcounter.com; worker-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'
  X-Frame-Options: DENY
  # l'application iPhone télécharge les villes depuis le site (onboarding) : lecture autorisée depuis l'app
  Access-Control-Allow-Origin: *

# données de Paris : appelées avec leur version (?v=…), gardées un an par le navigateur
/*.json
  Cache-Control: public, max-age=31536000, immutable
/*.txt
  Cache-Control: public, max-age=31536000, immutable
/graph.bin
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: application/octet-stream
# carte compressée : envoyée telle quelle, la page la décompresse
/graph.gz
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: application/octet-stream
